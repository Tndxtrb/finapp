# Copy to .env and fill in real values
DB_PATH=finance.db

# VAPID keys for Web Push (generate new ones at: https://vapidkeys.com/)
VAPID_PUBLIC=your_vapid_public_key
VAPID_PRIVATE=your_vapid_private_key
VAPID_EMAIL=mailto:your@email.com

# Secret for cron endpoints (/api/push/check-today, /api/push/remind-finances)
# Set to any random string; pass as X-Cron-Secret header from your scheduler
CRON_SECRET=
